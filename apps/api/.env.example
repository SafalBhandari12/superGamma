PORT=4000
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Azure OpenAI, same shape as greptileClone/src/config.ts:
# OPENAI_BASE_URL = the Azure OpenAI-compatible v1 endpoint,
#   e.g. https://<your-resource>.openai.azure.com/openai/v1
# OPENAI_MODEL = your Azure deployment name (not the raw model id)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Postgres connection string (Neon or otherwise) — holds better-auth's tables
DATABASE_URL=

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google Cloud Console > Credentials. Authorized redirect URI must be:
#   {API_BASE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Maileroo — sends verification/reset emails for email+password sign-up
MAILEROO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=superGamma
